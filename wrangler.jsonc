{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letsbuilda-dev",
  "compatibility_date": "2026-10-01",
  // A static site: the Worker only serves the files Astro builds into dist/.
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "letsbuilda.dev",
      "custom_domain": true
    }
  ],
  "preview_urls": true
}
